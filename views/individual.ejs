<%- include('partials/header') %>

  <section class="app-section active" style="max-width: 800px; margin: 0 auto;">

    <div style="text-align: center; margin-bottom: 30px;">
      <h2 style="font-size: 28px; color: #1a2e4a; font-weight: 900; margin-bottom: 10px;">👤 السجل الفردي</h2>
      <p style="color: #64748b; font-size: 16px;">ترتيب جميع الطلاب ونقاطهم الفردية</p>
    </div>

    <style>
      .individual-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .individual-card {
        background: #fff;
        border-radius: 12px;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.03);
        border: 1px solid rgba(0, 0, 0, 0.05);
        transition: transform 0.2s, box-shadow 0.2s;
      }

      .individual-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.08);
      }

      .ind-rank {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #f1f5f9;
        color: #64748b;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        font-weight: 900;
        flex-shrink: 0;
      }

      .individual-card.rank-1 .ind-rank {
        background: #fbbf24;
        color: #fff;
        box-shadow: 0 0 12px rgba(251, 191, 36, 0.5);
        font-size: 22px;
      }

      .individual-card.rank-2 .ind-rank {
        background: #94a3b8;
        color: #fff;
        box-shadow: 0 0 12px rgba(148, 163, 184, 0.5);
        font-size: 22px;
      }

      .individual-card.rank-3 .ind-rank {
        background: #d97706;
        color: #fff;
        box-shadow: 0 0 12px rgba(217, 119, 6, 0.5);
        font-size: 22px;
      }

      .individual-card.rank-1 {
        border-right: 5px solid #fbbf24;
      }

      .individual-card.rank-2 {
        border-right: 5px solid #94a3b8;
      }

      .individual-card.rank-3 {
        border-right: 5px solid #d97706;
      }

      .individual-card.rank-other {
        border-right: 5px solid #3b82f6;
      }

      .ind-info {
        flex-grow: 1;
      }

      .ind-name {
        font-size: 19px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 5px;
      }

      .ind-group {
        font-size: 13px;
        color: #64748b;
        display: inline-block;
        background: #f8fafc;
        padding: 4px 10px;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        font-weight: 600;
      }

      .ind-stats-container {
        display: flex;
        gap: 8px;
      }

      .ind-stat {
        text-align: center;
        background: #f8fafc;
        padding: 8px 12px;
        border-radius: 8px;
        min-width: 60px;
        border: 1px solid #e2e8f0;
      }
      
      .ind-stat-value {
        font-size: 18px;
        font-weight: 900;
        color: #3b82f6;
        display: block;
        line-height: 1.1;
        margin-bottom: 3px;
      }
      
      .ind-stat-label {
        font-size: 11px;
        color: #64748b;
        font-weight: 600;
      }
      
      .ind-points {
        text-align: center;
        background: #f8fafc;
        padding: 10px 16px;
        border-radius: 12px;
        min-width: 80px;
        border: 2px solid #3b82f6;
      }

      .individual-card.rank-1 .ind-points {
        background: rgba(251, 191, 36, 0.1);
        border-color: #fbbf24;
      }

      .individual-card.rank-2 .ind-points {
        background: rgba(148, 163, 184, 0.1);
        border-color: #94a3b8;
      }

      .individual-card.rank-3 .ind-points {
        background: rgba(217, 119, 6, 0.1);
        border-color: #d97706;
      }

      .ind-points-value {
        font-size: 24px;
        font-weight: 900;
        color: #3b82f6;
        display: block;
        line-height: 1.1;
      }

      .individual-card.rank-1 .ind-points-value {
        color: #d97706;
      }

      .individual-card.rank-2 .ind-points-value {
        color: #64748b;
      }

      .individual-card.rank-3 .ind-points-value {
        color: #9a3412;
      }

      .ind-points-label {
        font-size: 12px;
        color: #64748b;
        font-weight: 700;
      }
    </style>

    <div class="individual-list">
      <% if (allStudents && allStudents.length> 0) { %>
        <% allStudents.forEach((s, i)=> {
          const isTop3 = i < 3; 
          const rankClass=isTop3 ? `rank-${i+1}` : 'rank-other'; 
          const rankIcon=i===0 ? '🏆' : i===1 ? '🥈' : i===2 ? '🥉' : (i + 1); 
        %>
            <div class="individual-card <%= rankClass %>">
              <div class="ind-rank">
                <%= rankIcon %>
              </div>

              <div class="ind-info">
                <div class="ind-name">
                  <%= s.name %>
                </div>
                <div class="ind-group">أسرة <%= s.group_name %>
                </div>
              </div>

              <div class="ind-stats-container">
                <div class="ind-stat">
                  <span class="ind-stat-value"><%= s.initiatives_points || 0 %></span>
                  <span class="ind-stat-label">مبادرات</span>
                </div>
                <div class="ind-stat">
                  <span class="ind-stat-value"><%= s.attendance_points || 0 %></span>
                  <span class="ind-stat-label">حضور</span>
                </div>
                <div class="ind-stat">
                  <span class="ind-stat-value"><%= s.knowledge_points || 0 %></span>
                  <span class="ind-stat-label">ذاتي</span>
                </div>
              </div>

              <div class="ind-points">
                <span class="ind-points-value">
                  <%= s.total_points %>
                </span>
                <span class="ind-points-label">الإجمالي</span>
              </div>
            </div>
            <% }) %>
              <% } else { %>
                <div
                  style="text-align: center; padding: 40px; background: #f8fafc; border-radius: 12px; color: #64748b;">
                  لا يوجد طلاب حالياً في النظام
                </div>
                <% } %>
    </div>

  </section>

  <%- include('partials/footer') %>