<%- include('partials/header') %>

  <section class="app-section active">
    <div class="supervisor-panel-header">
      <h3 class="panel-welcome">📤 تذكير نهاية الأسبوع عبر واتساب</h3>
      <a href="/supervisor/panel" class="btn btn-outline btn-small">‹ رجوع للوحة المشرفين</a>
    </div>
    <p class="section-desc">
      قائمة الطلاب الذين لم يُنجزوا أحد متطلبات الذاتي أو لم يحضروا أحد أيام الأسبوع المحدد.
    </p>

    <% if (!whatsappConfigured) { %>
      <div class="panel-box" style="margin-bottom:18px; border:1.5px solid var(--warning);">
        <strong>⚠️ الإرسال الرسمي التلقائي غير مفعَّل بعد</strong>
        <p class="section-desc" style="margin:6px 0 0; font-size:13px;">
          لم يتم ضبط بيانات WhatsApp Business API (Meta Cloud API) بعد. حالياً يمكنك الإرسال يدوياً فقط عبر زر "wa.me" الذي يفتح واتساب على جهازك.
          بعد ضبط متغيرات البيئة (WHATSAPP_ACCESS_TOKEN وWHATSAPP_PHONE_NUMBER_ID وWHATSAPP_TEMPLATE_NAME) سيظهر زر "إرسال تلقائي" تلقائياً.
        </p>
      </div>
    <% } %>

    <div class="panel-box" style="margin-bottom:18px;">
      <div class="form-group" style="margin-bottom:0;">
        <label for="weekSelect">الأسبوع</label>
        <select id="weekSelect" class="form-select" onchange="location.href='/supervisor/weekly-reminders?week=' + this.value">
          <% for (let w = 1; w <= 16; w++) { %>
            <option value="<%= w %>" <%= w === weekNumber ? 'selected' : '' %>>الأسبوع <%= w %></option>
          <% } %>
        </select>
      </div>
    </div>

    <% if (!list.length) { %>
      <div class="panel-box">
        <p class="empty-note">لا يوجد طلاب متأخرون عن متطلبات هذا الأسبوع 🎉</p>
      </div>
    <% } else { %>
      <% if (whatsappConfigured) { %>
        <div class="panel-box" style="margin-bottom:18px;">
          <button type="button" id="sendSelectedBtn" class="btn btn-primary" style="width:100%;">🚀 إرسال للمحددين فقط</button>
          <p class="form-msg" id="sendAllMsg"></p>
        </div>
      <% } %>

      <div class="data-table-wrapper">
        <table class="data-table" id="remindersTable">
          <thead>
            <tr>
              <th><input type="checkbox" id="selectAllReminders" checked></th>
              <th>#</th>
              <th>الاسم</th>
              <th>الأسرة</th>
              <th>الجوال</th>
              <th>سبب التذكير</th>
              <th>مراسلة يدوي</th>
              <% if (whatsappConfigured) { %><th>مراسلة تلقائي</th><% } %>
            </tr>
          </thead>
          <tbody>
            <% list.forEach((s, i) => {
              const reasons = [];
              if (s.missedDays > 0) reasons.push('لم يحضر يوماً على الأقل من أيام الأسبوع');
              if (s.missedTasks > 0) reasons.push('لم ينجز أحد متطلبات الذاتي');
              const reasonText = reasons.join(' و ');
              const message = `السلام عليكم\nنود تذكير الطالب/ة ${s.name} (${s.group_name}) بأنه ${reasonText} للأسبوع ${weekNumber} في قسم واعد. نأمل الحرص الأسبوع القادم 🌷`;
              const intlPhone = s.phone && /^05\d{8}$/.test(s.phone) ? '966' + s.phone.slice(1) : null;
              const waLink = intlPhone ? `https://wa.me/${intlPhone}?text=${encodeURIComponent(message)}` : null;
            %>
              <tr data-student-id="<%= s.id %>">
                <td><input type="checkbox" class="reminder-cb" value="<%= s.id %>" checked></td>
                <td><%= i + 1 %></td>
                <td><%= s.name %></td>
                <td><%= s.group_name %></td>
                <td><%= s.phone || '—' %></td>
                <td style="font-size:12px;"><%= reasonText %></td>
                <td>
                  <% if (waLink) { %>
                    <a href="<%= waLink %>" target="_blank" class="btn btn-gold btn-small">📤 wa.me</a>
                  <% } else { %>
                    <span class="empty-note" style="font-size:12px;">لا يوجد رقم جوال</span>
                  <% } %>
                </td>
                <% if (whatsappConfigured) { %>
                  <td>
                    <button type="button" class="btn btn-primary btn-small btn-send-auto" data-student-id="<%= s.id %>" <%= s.phone ? '' : 'disabled' %>>🤖 إرسال</button>
                  </td>
                <% } %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

<%- include('partials/footer') %>

<script>
  const weekNumber = <%= weekNumber %>;

  document.querySelectorAll(".btn-send-auto").forEach((btn) => {
    btn.addEventListener("click", async () => {
      btn.disabled = true;
      btn.textContent = "جارٍ الإرسال...";
      try {
        const res = await fetch("/api/supervisor/weekly-reminders/send", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ studentId: btn.dataset.studentId, weekNumber }),
        });
        const data = await res.json();
        if (data.success) {
          btn.textContent = "✅ أُرسلت";
        } else {
          alert(data.message || "فشل الإرسال");
          btn.textContent = "🤖 إرسال";
          btn.disabled = false;
        }
      } catch (e) {
        alert("حدث خطأ في الاتصال بالخادم");
        btn.textContent = "🤖 إرسال";
        btn.disabled = false;
      }
    });
  });

      const selectAll = document.getElementById("selectAllReminders");
  if (selectAll) {
    selectAll.addEventListener("change", (e) => {
      document.querySelectorAll(".reminder-cb").forEach(cb => cb.checked = e.target.checked);
    });
  }

  const sendSelectedBtn = document.getElementById("sendSelectedBtn");
  if (sendSelectedBtn) {
    sendSelectedBtn.addEventListener("click", async () => {
      const selectedCb = Array.from(document.querySelectorAll(".reminder-cb:checked"));
      if (selectedCb.length === 0) {
        alert("الرجاء تحديد طالب واحد على الأقل");
        return;
      }
      
      const studentIds = selectedCb.map(cb => Number(cb.value));

      if (!confirm("سيتم إرسال رسالة تذكير للطلاب المحددين (" + studentIds.length + " طالب). متأكد؟")) return;
      
      sendSelectedBtn.disabled = true;
      sendSelectedBtn.textContent = "جاري الإرسال للمحددين...";
      const msg = document.getElementById("sendAllMsg");
      try {
        const res = await fetch("/api/supervisor/weekly-reminders/send-all", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ weekNumber, studentIds }),
        });
        const data = await res.json();
        if (!data.success) {
          msg.className = "form-msg error";
          msg.textContent = data.message || "حدث خطأ";
        } else {
          msg.className = "form-msg success";
          msg.textContent = `تم الإرسال لـ ${data.sent} طالب بنجاح. (${data.failed.length} فشل)`;
          if (data.failed.length > 0) {
            console.log("Failed:", data.failed);
          }
        }
      } catch (e) {
        msg.className = "form-msg error";
        msg.textContent = "حدث خطأ في الاتصال بالخادم";
      } finally {
        sendSelectedBtn.disabled = false;
        sendSelectedBtn.textContent = "🚀 إرسال للمحددين فقط";
      }
    });
  }
</script>
