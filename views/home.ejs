<%- include('partials/header') %>

<style>
  .app-main { max-width: 100% !important; padding: 0 !important; margin: 0 !important; height: calc(100vh - 75px); }
  .app-footer { display: none !important; }
  body { overflow: hidden; } /* Disable outer scroll */
</style>

<section class="game-map-viewport" id="mapViewport">

  <!-- Title Floating -->
  <div style="position: fixed; left: 50%; transform: translateX(-50%); top: 90px; z-index: 100; text-align: center; background: rgba(255,255,255,0.9); padding: 12px 24px; border-radius: 20px; backdrop-filter: blur(4px); box-shadow: 0 4px 10px rgba(0,0,0,0.1); pointer-events: none;">
    <h2 style="font-size: 20px; color: var(--navy); margin-bottom: 4px; font-family: var(--font-display); font-weight: 800;">رحلة الوعد إلى مكة المكرمة 🕋</h2>
    <p style="font-size: 13px; color: #444; margin: 0; font-weight: 600;">الهدف: <%= TARGET_POINTS %> كم</p>
  </div>

  <div class="svg-map-container">
    <!-- SVG Path for the Winding Road -->
    <svg id="mapSvg" viewBox="0 0 400 2000" preserveAspectRatio="xMidYMid meet">
      <!-- Outer Dirt Path -->
      <path id="mainPath" 
            d="M200,1950 C50,1800 50,1600 200,1500 C350,1400 350,1200 200,1100 C50,1000 50,800 200,700 C350,600 350,400 200,300 C50,200 200,50 200,50" 
            fill="none" stroke="#D6A862" stroke-width="45" stroke-linecap="round"/>
      
      <!-- Inner Dashed Line -->
      <path d="M200,1950 C50,1800 50,1600 200,1500 C350,1400 350,1200 200,1100 C50,1000 50,800 200,700 C350,600 350,400 200,300 C50,200 200,50 200,50" 
            fill="none" stroke="#F4DCA1" stroke-width="4" stroke-dasharray="15, 15" stroke-linecap="round"/>
    </svg>

    <!-- Pins Container -->
    <div id="pinsContainer"></div>
  </div>
</section>

<!-- Inject data for client-side plotting -->
<script>
  const allStudents = <%- JSON.stringify(allStudents) %>;
  const targetPoints = <%= TARGET_POINTS %>;
  
  document.addEventListener('DOMContentLoaded', () => {
    const path = document.getElementById('mainPath');
    const pinsContainer = document.getElementById('pinsContainer');
    const pathLength = path.getTotalLength();
    
    // 1. Draw Stations (Milestones)
    const stations = [
      { points: 0, icon: '🏙️', name: 'الرياض' },
      { points: 200, icon: '⛽', name: 'استراحة' },
      { points: 400, icon: '🌴', name: 'واحة' },
      { points: 600, icon: '⛽', name: 'استراحة' },
      { points: 800, icon: '🌴', name: 'واحة' },
      { points: 1000, icon: '🕋', name: 'مكة المكرمة' },
    ];
    
    stations.forEach(st => {
      let progress = st.points / targetPoints;
      if (progress > 1) progress = 1;
      
      const pt = path.getPointAtLength(progress * pathLength);
      const x = (pt.x / 400) * 100;
      const y = (pt.y / 2000) * 100;
      
      const stDiv = document.createElement('div');
      stDiv.className = 'game-station';
      stDiv.style.left = `${x}%`;
      stDiv.style.top = `${y}%`;
      stDiv.innerHTML = `
        <div class="station-icon-lg">${st.icon}</div>
        <div class="station-name-lg">${st.name} <span style="opacity:0.7; font-size:11px;">(${st.points} كم)</span></div>
      `;
      pinsContainer.appendChild(stDiv);
    });

    // 2. Draw Students
    // Group students by exact score to handle overlaps
    const pointGroups = {};
    allStudents.forEach(s => {
      if(!pointGroups[s.total_points]) pointGroups[s.total_points] = [];
      pointGroups[s.total_points].push(s);
    });
    
    let rank = 1;
    
    // Iterate over groups (sorted descending so rank 1 is highest points)
    const sortedPoints = Object.keys(pointGroups).map(Number).sort((a,b) => b - a);
    
    sortedPoints.forEach(pts => {
      const group = pointGroups[pts];
      let progress = pts / targetPoints;
      if (progress > 1) progress = 1;
      if (progress < 0) progress = 0;
      
      const pt = path.getPointAtLength(progress * pathLength);
      const xPercent = (pt.x / 400) * 100;
      const yPercent = (pt.y / 2000) * 100;
      
      group.forEach((student, idx) => {
        // Scatter logic for same exact point (Circular cluster)
        let offsetX = 0;
        let offsetY = 0;
        
        if (idx > 0) {
          const ring = Math.floor((idx - 1) / 6) + 1; 
          const radius = ring * 18; // pixels
          const angle = ((idx - 1) % 6) * 60; // 0, 60, 120, 180, 240, 300
          const rad = angle * (Math.PI / 180);
          offsetX = Math.cos(rad) * radius;
          offsetY = Math.sin(rad) * radius;
        }
        
        const pin = document.createElement('div');
        const rankClass = rank <= 5 ? `pin-rank-${rank}` : '';
        pin.className = `student-pin tooltip ${rankClass}`;
        
        pin.style.left = `calc(${xPercent}% + ${offsetX}px)`;
        pin.style.top = `calc(${yPercent}% + ${offsetY}px)`;
        
        pin.innerHTML = `
          ${rank}
          <span class="tooltiptext">${student.name} (${pts} كم)</span>
        `;
        
        pinsContainer.appendChild(pin);
        rank++;
      });
    });

    // 3. Scroll to Bottom (Start of Journey) initially
    const viewport = document.getElementById('mapViewport');
    if (viewport) {
      viewport.scrollTop = viewport.scrollHeight - viewport.clientHeight;
    }
  });
</script>

<%- include('partials/footer') %>