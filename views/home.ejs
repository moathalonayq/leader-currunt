<%- include('partials/header') %>

<style>
  .app-main { max-width: 100% !important; padding: 0 !important; margin: 0 !important; height: calc(100vh - 75px); }
  .app-footer { display: none !important; }
  body { overflow: hidden; } /* Disable outer scroll */
  
  /* Make map wrapper truly fullscreen */
  .journey-map-wrapper {
    height: 100% !important;
    min-height: unset !important;
    margin: 0 !important;
    padding: 0 !important;
    border-radius: 0 !important;
    border: none !important;
    overflow: auto; /* Enable scrolling inside the map */
  }
  
  /* Fix container so pins can overflow vertically inside the scrollable wrapper if needed */
  .journey-track-container {
    height: 100% !important;
    min-height: 500px !important;
  }
</style>

  <section class="app-section active" style="height: 100%; position: relative;">

    <!-- Map Container -->
    <div class="journey-map-wrapper">
      
      <!-- Title Floating -->
      <div class="journey-header" style="position: sticky; left: 50%; transform: translateX(-50%); top: 20px; z-index: 100; text-align: center; background: rgba(255,255,255,0.85); padding: 12px 24px; border-radius: 20px; backdrop-filter: blur(4px); display: inline-block; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
        <h2 class="section-title" style="font-size: 22px; color: var(--navy); margin-bottom: 4px;">رحلة الوعد إلى مكة المكرمة 🕋</h2>
        <p class="section-desc" style="font-size: 14px; color: #444; margin: 0;">الهدف: <%= TARGET_POINTS %> كم</p>
      </div>

      <!-- أزرار التوسيع والتصغير -->
      <div class="map-controls">
        <button class="map-btn" onclick="zoomMap(1500)">➕ توسيع الخريطة</button>
        <button class="map-btn" onclick="zoomMap(-1500)">➖ تصغير</button>
      </div>

      <div class="journey-track-container" id="mapTrack">
        
        <!-- The Road Line -->
        <div class="journey-track"></div>
        
        <!-- Start City (Riyadh) -->
        <div class="city-marker start-city">
          <div class="city-icon">🏙️</div>
          <div class="city-name">الرياض</div>
          <div class="city-dist">0 كم</div>
        </div>

        <!-- Waypoint Stations -->
        <div class="station-marker" style="right: 20%;">
          <div class="station-icon">⛽</div>
          <div class="station-dist">200 كم</div>
        </div>
        <div class="station-marker" style="right: 40%;">
          <div class="station-icon">🌴</div>
          <div class="station-dist">400 كم</div>
        </div>
        <div class="station-marker" style="right: 60%;">
          <div class="station-icon">⛽</div>
          <div class="station-dist">600 كم</div>
        </div>
        <div class="station-marker" style="right: 80%;">
          <div class="station-icon">🌴</div>
          <div class="station-dist">800 كم</div>
        </div>

        <!-- End City (Mecca) -->
        <div class="city-marker end-city">
          <div class="city-icon">🕋</div>
          <div class="city-name">مكة المكرمة</div>
          <div class="city-dist"><%= TARGET_POINTS %> كم</div>
        </div>

        <!-- Student Pins -->
        <% 
          const pointCounts = {};
          allStudents.forEach((s, i) => { 
            const points = s.total_points;
            pointCounts[points] = (pointCounts[points] || 0) + 1;
            const verticalIdx = pointCounts[points] - 1; 
            
            let progress = (points / TARGET_POINTS) * 100;
            if (progress > 100) progress = 100;
            if (progress < 0) progress = 0; 
            
            // نفس خط الطول: توزيع الطلاب فوق وتحت الطريق بشكل متناوب (بدون إزاحة أفقية)
            const isTop = verticalIdx % 2 === 0; // الزوجي فوق
            const step = Math.floor(verticalIdx / 2); // 0, 1, 2, 3...
            
            // الطريق يقع في المنتصف (top: 50%). ارتفاعه 24 بيكسل (أي 12 بيكسل للأعلى و12 للأسفل).
            // الدبوس ارتفاعه 28 بيكسل. لكي يجلس فوق الطريق نستخدم 12 بيكسل + (ترتيب الدبوس × 29 بيكسل مسافة)
            const stackOffset = 14 + (step * 29); // 14px clearance from center, then 29px per stack

            let positionStyle = '';
            if (isTop) {
              positionStyle = `bottom: calc(50% + ${stackOffset}px);`; // يصعد للأعلى
            } else {
              positionStyle = `top: calc(50% + ${stackOffset}px);`; // ينزل للأسفل
            }

            const rankClass = i < 5 ? `pin-rank-${i + 1}` : ''; 
        %>
          <div class="student-pin tooltip <%= rankClass %>" 
               style="right: <%= progress %>%; <%= positionStyle %>">
            <%= i + 1 %>
            <span class="tooltiptext"><%= s.name %> (<%= points %> كم)</span>
          </div>
        <% }) %>
      </div>
    </div>

  </section>

  <%- include('partials/footer') %>
<script>
  let currentMapWidth = 4000;
  function zoomMap(amount) {
    const track = document.getElementById("mapTrack");
    if (!track) return;
    currentMapWidth += amount;
    if (currentMapWidth < 1500) currentMapWidth = 1500; // Minimum width
    if (currentMapWidth > 15000) currentMapWidth = 15000; // Maximum width
    track.style.minWidth = currentMapWidth + "px";
  }
</script>

